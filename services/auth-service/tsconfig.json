{
  "compilerOptions": {
		 // Система модулей: CommonJS — стандарт для Nest.js
    // Другие варианты: ESNext, NodeNext (для ESM проектов)
    "module": "commonjs",
		// Как искать модули: node — классический способ Node.js
    // Альтернатива: bundler, nodenext
    "moduleResolution": "node",
		// Версия JavaScript: ES2022 — современный стандарт
		// В какую версию JS компилировать
    // ES2022 = современный JS с топ-фичами: await, class fields, etc.
    "target": "ES2022",
		// Позволяет делать import X from 'module' вместо import * as X
    // Нужно для совместимости с ESM пакетами (Prisma 8, cookie-parser)
    // иногда Prisma выдаёт ошибку, что не может найти модуль
    // Позволяет использовать ES-модули в CommonJS
    "esModuleInterop": true,
    // Позволяет использовать default-импорты в модулях без явного указания
    // Нужно для совместимости с ESM пакетами (Prisma 8, cookie-parser)
    // иногда Prisma выдаёт ошибку, что не может найти модуль
		// Разрешает default импорт из пакетов без default export
    // Работает вместе с esModuleInterop
    "allowSyntheticDefaultImports": true,
    // Создает source map для отладки TypeScript
    // Нужно для того, чтобы отлаживать TypeScript код в браузере
		// Генерировать .map файлы для отладки (показывает TS код в debugger)
    // В production можно отключить для уменьшения размера
    "sourceMap": true,
    // Папка для сборки: ./dist — директория с компилированным кодом
		// Куда складывать скомпилированные JS файлы
		// Нужно для того, чтобы корректно работать с относительными путями в import
    "outDir": "./dist",
    // Базовый путь для поиска модулей: текущий каталог
		// Нужно для того, чтобы корректно работать с относительными путями в import
		// Базовая папка для резолвинга модулей
    // Используется с "paths" для алиасов модулей
    "baseUrl": "./",
    // Включает инкрементальную компиляцию (быстрее при разработке)
    // Нужно для того, чтобы компилировать только измененные файлы
		// Инкрементальная компиляция — быстрее повторные сборки
    // Создаёт файл .tsbuildinfo для кэша
    // Позволяет избежать повторной компиляции измененных файлов
    "incremental": true, 
    // Пропускает проверку типов из сторонних библиотек
    // Нужно для того, чтобы не проверять типы из сторонних библиотек
		// Пропускает проверку типов в node_modules
    // ✅ Ускоряет сборку
    // ❌ Может пропустить реальные ошибки в библиотеках
    "skipLibCheck": true,
    // Отключает строгие проверки на null/undefined
		// ⚠️ ОТКЛЮЧЕНО: проверка null/undefined
    // Если true — TS будет требовать проверки user !== null
    // Если false — можно вызвать user.email без проверки (риск runtime error)
    "strictNullChecks": false,
    // Отключает неявные any типы
    // ⚠️ ОТКЛЮЧЕНО: не проверяет типы в коде
    // Если true — TS будет требовать явное указание типа
    // Если false — можно использовать any типы без явного указания
    "noImplicitAny": false,
    // Отключает строгие проверки привязки аргументов
    // ⚠️ ОТКЛЮЧЕНО: не проверяет привязку аргументов
    // Если true — TS будет требовать проверки привязки аргументов
    // Если false — можно вызвать функцию без проверки аргументов (риск runtime error)
		// Если true — TS не даст написать function foo(x) без типа
    // Если false — можно вызвать функцию без проверки аргументов (риск runtime error)
		// ⚠️ ОТКЛЮЧЕНО: строгая проверка bind/call/apply
    "strictBindCallApply": false,
    // Отключает строгие проверки регистрации файлов
		// ⚠️ ОТКЛЮЧЕНО: проверка регистра в импортах
    // На Linux Foo.ts и foo.ts — разные файлы
    // Если true — будет ошибка при несовпадении регистра
    "forceConsistentCasingInFileNames": false,
    // Отключает проверку пропущенных case в switch
    // ⚠️ ОТКЛЮЧЕНО: пропущенные case в switch
    // Если true — будет ошибка при пропуске case
    // Если false — можно пропустить case без ошибки
		// ⚠️ ОТКЛЮЧЕНО: проверка fallthrough в switch
    // Если true — TS будет требовать break в каждом case
    // Если false — можно пропустить break без ошибки
    "noFallthroughCasesInSwitch": false,
    // Включает экспериментальные декораторы
		// ⚠️ ОТКЛЮЧЕНО: экспериментальные декораторы
    // Если true — TS будет использовать экспериментальные декораторы
    // Если false — можно использовать только стандартные декораторы
    "experimentalDecorators": true,
    // Включает метаданные декораторов
		// ⚠️ ОТКЛЮЧЕНО: метаданные декораторов
    // Если true — TS будет использовать метаданные декораторов
    // Если false — можно использовать только стандартные декораторы
		// ✅ ОБЯЗАТЕЛЬНО для Nest.js DI: сохраняет типы в metadata
    // Без этого Dependency Injection не работает
    "emitDecoratorMetadata": true,
    // Позволяет использовать JavaScript в TypeScript
		// Разрешает импортировать .js файлы в .ts
		// Нужно для совместимости с JavaScript библиотеками (cookie-parser)
    "allowJs": true,
    // Позволяет использовать JSON-модули
		 // Разрешает import contract.json (для Prisma 8)
    "resolveJsonModule": true,
    // Создает декларации TypeScript для модулей
		// Генерировать .d.ts файлы (для библиотек)
    // Для приложения можно отключить, если не нужно генерировать .d.ts файлы
		// ⚠️ ОТКЛЮЧЕНО: генерирует .d.ts файлы (для библиотек)
    "declaration": true,
    // Убирает комментарии из компилированного кода
    // ⚠️ ОТКЛЮЧЕНО: убирает комментарии из компилированного кода
    // Если true — будет ошибка при комментировании кода
    // Если false — можно комментировать код
    "removeComments": false,
    // Список библиотек: ES2022 — современный стандарт
		// Генерировать .d.ts файлы (для библиотек)
    // Для приложения можно отключить
    "lib": ["ES2022"],
    // Список плагинов: пустой массив
		// Плагины TypeScript (например, для Nest.js CLI)
    "plugins": [],
    // Путь к модулю Prisma: ./node_modules/@prisma/orm-postgres/dist/runtime.d.mts
		// Нужно для того, чтобы корректно работать с Prisma
		// Алиасы для импортов
    // Позволяет писать import from '@prisma/orm-postgres/runtime'
    // вместо длинного пути ./node_modules/@prisma/orm-postgres/dist/runtime.d.mts
    "paths": {
      "@prisma/orm-postgres/runtime": ["./node_modules/@prisma/orm-postgres/dist/runtime.d.mts"]
    }
  },
	// ========== ЧТО КОМПИЛИРОВАТЬ ==========
  // Включаем все .ts файлы в src/ и подпапки
  // Список файлов для включения в компиляцию: ./src/**/*
  "include": ["src/**/*"],
	// ========== ЧТО ИГНОРИРОВАТЬ ==========
  // Список файлов для исключения из компиляции: node_modules, dist, test, **/*spec.ts
  "exclude": [
		"node_modules",   // зависимости
    "dist",           // скомпилированный код
    "test",           // тесты (у них свой tsconfig)
    "**/*spec.ts"     // unit-тесты
	]
}
